<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android Go biasanya tidak punya banyak RAM, tapi permission ini tidak menambah beban -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoGoLive"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GoGoLive.Splash"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:theme="@style/Theme.GoGoLive" />

        <!--
          Activity tak terlihat, dipicu dari LiveQuickTileService (Quick Settings Tile).
          Tujuannya supaya mulai live tidak perlu membuka MainActivity yang layar penuh -
          penting untuk kasus spacedesk supaya orientasi landscape yang sedang aktif
          tidak keganggu/reset ke potrait.
        -->
        <activity
            android:name=".ui.QuickStartActivity"
            android:exported="false"
            android:theme="@style/Theme.GoGoLive.Invisible"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
          Service ini yang benar-benar melakukan capture layar + streaming.
          Berjalan sebagai FOREGROUND SERVICE BIASA (bukan bubble/overlay),
          jadi tidak menggambar apapun di atas aplikasi lain - hanya notifikasi
          persisten di status bar seperti yang diwajibkan Android untuk
          MediaProjection berjalan di background.
        -->
        <service
            android:name=".service.ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <!--
          Quick Settings Tile - muncul di notification shade setelah user
          menambahkannya lewat menu edit tile. Memungkinkan mulai/stop live
          tanpa membuka aplikasi ini secara penuh.
        -->
        <service
            android:name=".service.LiveQuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_live"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
